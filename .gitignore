# Local secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json

# Reference media and generated output; files remain on the local machine.
/ref_pic/
/_debug_out/
/artifacts/**
# Keep only the small, human-readable final test report and summary.
!/artifacts/live-final/
!/artifacts/live-final/report.md
!/artifacts/live-final/summary.json

